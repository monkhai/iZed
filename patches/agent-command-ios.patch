+/// A finite command on the Machine. The exit receiver resolves after all output closes.
+pub struct SshCommandSession {
+    pub terminal: SshTerminalSession,
+    pub exit_rx: SmolReceiver<Option<u32>>,
+    pub cancel_tx: SmolSender<()>,
+}
+
+struct CancelCommandOnDrop(Option<SmolSender<()>>);
+
+impl Drop for CancelCommandOnDrop {
+    fn drop(&mut self) {
+        if let Some(cancel_tx) = self.0.take() {
+            cancel_tx.try_send(()).ok();
+        }
+    }
+}
+
+fn ssh_command_line(
+    program: &str,
+    arguments: &[String],
+    environment: &HashMap<String, String>,
+    working_directory: Option<&Path>,
+) -> Result<String> {
+    anyhow::ensure!(!program.is_empty(), "Remote command is empty");
+    let mut command = String::new();
+    if let Some(path) = working_directory {
+        anyhow::ensure!(
+            path.is_absolute(),
+            "Remote working directory must be absolute"
+        );
+        command.push_str("cd ");
+        command.push_str(&ssh_quote(&path.to_string_lossy()));
+        command.push_str(" && ");
+    }
+    command.push_str("exec env");
+    for (name, value) in environment {
+        anyhow::ensure!(
+            !name.is_empty()
+                && name.bytes().enumerate().all(|(i, c)| {
+                    c == b'_' || c.is_ascii_alphabetic() || (i > 0 && c.is_ascii_digit())
+                }),
+            "Invalid remote environment variable name: {name:?}"
+        );
+        command.push(' ');
+        command.push_str(&ssh_quote(&format!("{name}={value}")));
+    }
+    command.push(' ');
+    command.push_str(&ssh_quote(program));
+    for argument in arguments {
+        command.push(' ');
+        command.push_str(&ssh_quote(argument));
+    }
+    Ok(command)
+}
+
+pub async fn open_ssh_command(
+    options: SshConnectionOptions,
+    program: String,
+    arguments: Vec<String>,
+    environment: HashMap<String, String>,
+    working_directory: Option<PathBuf>,
+) -> Result<SshCommandSession> {
+    let command = ssh_command_line(
+        &program,
+        &arguments,
+        &environment,
+        working_directory.as_deref(),
+    )?;
+    let (input_tx, input_rx) = smol::channel::unbounded();
+    let (resize_tx, resize_rx) = smol::channel::unbounded();
+    let (output_tx, output_rx) = smol::channel::bounded(64);
+    let (exit_tx, exit_rx) = smol::channel::bounded(1);
+    let (cancel_tx, cancel_rx) = smol::channel::bounded(1);
+    let mut cancel_on_drop = CancelCommandOnDrop(Some(cancel_tx.clone()));
+    let (ready_tx, ready_rx) = smol::channel::bounded::<std::result::Result<(), String>>(1);
+
+    std::thread::Builder::new()
+        .name("ized-ssh-command".into())
+        .spawn(move || {
+            let result = run_ssh_terminal_command(
+                options,
+                command,
+                input_rx,
+                resize_rx,
+                cancel_rx,
+                output_tx.clone(),
+                ready_tx.clone(),
+            );
+            match result {
+                Ok(status) => {
+                    drop(output_tx);
+                    exit_tx.send_blocking(status).ok();
+                }
+                Err(error) => {
+                    let message = format!("{error:#}");
+                    if ready_tx.try_send(Err(message.clone())).is_err() {
+                        output_tx
+                            .send_blocking(format!("\r\n[SSH command: {message}]\r\n").into_bytes())
+                            .ok();
+                        drop(output_tx);
+                        exit_tx.send_blocking(None).ok();
+                    }
+                }
+            }
+        })?;
+    ready_rx
+        .recv()
+        .await
+        .context("SSH command stopped before opening")?
+        .map_err(anyhow::Error::msg)?;
+    cancel_on_drop.0 = None;
+    Ok(SshCommandSession {
+        terminal: SshTerminalSession {
+            input_tx,
+            resize_tx,
+            output_rx,
+        },
+        exit_rx,
+        cancel_tx,
+    })
+}
+
+fn run_ssh_terminal_command(
+    options: SshConnectionOptions,
+    command: String,
+    input_rx: SmolReceiver<Vec<u8>>,
+    resize_rx: SmolReceiver<(u32, u32)>,
+    cancel_rx: SmolReceiver<()>,
+    output_tx: SmolSender<Vec<u8>>,
+    ready_tx: SmolSender<std::result::Result<(), String>>,
+) -> Result<Option<u32>> {
+    let (runtime, handle) = connect_with_connection_timeout(&options, Duration::from_secs(15))?;
+    runtime.block_on(async move {
+        let mut channel = tokio::select! {
+            biased;
+            _ = cancel_rx.recv() => return Ok(None),
+            result = tokio::time::timeout(Duration::from_secs(15), async {
+                let channel = handle.channel_open_session().await?;
+                channel.request_pty(true, "xterm-256color", 80, 24, 0, 0, &[]).await?;
+                channel.exec(true, command).await?;
+                anyhow::Ok(channel)
+            }) => result.context("SSH command start timed out; it may have started, so do not retry automatically")??,
+        };
+        ready_tx.send(Ok(())).await.ok();
+        let mut exit_status = None;
+        let mut input_open = true;
+        let mut resize_open = true;
+        loop {
+            tokio::select! {
+                biased;
+                _ = cancel_rx.recv() => {
+                    // Never let a stalled network keep the tool's timeout waiting forever.
+                    tokio::time::timeout(Duration::from_secs(2), channel.data_bytes(vec![3])).await.ok();
+                    tokio::time::timeout(Duration::from_secs(2), channel.close()).await.ok();
+                    return Ok(None);
+                },
+                message = channel.wait() => match message {
+                    Some(ChannelMsg::Data { data }) | Some(ChannelMsg::ExtendedData { data, .. }) => {
+                        if output_tx.send(data.as_ref().to_vec()).await.is_err() { break; }
+                    }
+                    Some(ChannelMsg::ExitStatus { exit_status: code }) => exit_status = Some(code),
+                    Some(_) => {},
+                    None => break,
+                },
+                input = input_rx.recv(), if input_open => match input {
+                    Ok(bytes) => channel.data_bytes(bytes).await?,
+                    Err(_) => input_open = false,
+                },
+                resize = resize_rx.recv(), if resize_open => match resize {
+                    Ok((columns, rows)) => channel.window_change(columns, rows, 0, 0).await?,
+                    Err(_) => resize_open = false,
+                },
+            }
+        }
+        anyhow::ensure!(exit_status.is_some(), "SSH connection closed before the command reported an exit status");
+        Ok(exit_status)
+    })
+}
