@@ -0,0 +1,597 @@
+//! iPad SSH transport for Zed's existing remote workspace protocol.
+//!
+//! Desktop Zed launches OpenSSH as a subprocess. iPadOS cannot launch that
+//! program, so this transport carries the same proxy protocol over Russh.
+
+use crate::{
+    CommandTemplate, Interactive, RemoteClientDelegate, RemoteConnection, RemoteConnectionOptions,
+    transport::ssh::SshConnectionOptions,
+};
+use anyhow::{Context as _, Result, anyhow, bail};
+use async_trait::async_trait;
+use collections::HashMap;
+use futures::{
+    StreamExt as _,
+    channel::mpsc::{Sender, UnboundedReceiver, UnboundedSender},
+};
+use gpui::{App, AppContext as _, AsyncApp, Task};
+use prost::Message as _;
+use rpc::proto::Envelope;
+use russh::{
+    ChannelMsg, client,
+    keys::{Algorithm, HashAlg, PrivateKey, PrivateKeyWithHashAlg, PublicKeyOrCertificate},
+};
+use sha2::{Digest as _, Sha256};
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{Read as _, Write as _},
+    os::unix::fs::{OpenOptionsExt as _, PermissionsExt as _},
+    path::PathBuf,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, AtomicU64, AtomicU8, Ordering},
+    },
+    time::Duration,
+};
+use util::paths::{PathStyle, RemotePathBuf};
+
+struct HostKeyVerifier {
+    expected_fingerprint: String,
+}
+
+/// Identity presented by an SSH server before user authentication.
+#[derive(Clone)]
+pub struct SshHostIdentity {
+    pub fingerprint: String,
+    pub public_key: String,
+    pub trusted: bool,
+    pub changed: bool,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum SshServerPhase { Checking, Uploading, Installing, Ready }
+
+#[derive(Default)]
+pub struct SshServerProgress {
+    phase: AtomicU8,
+    sent: AtomicU64,
+    total: AtomicU64,
+}
+
+impl SshServerProgress {
+    pub fn snapshot(&self) -> (SshServerPhase, u64, u64) {
+        let phase = match self.phase.load(Ordering::Relaxed) {
+            1 => SshServerPhase::Uploading,
+            2 => SshServerPhase::Installing,
+            3 => SshServerPhase::Ready,
+            _ => SshServerPhase::Checking,
+        };
+        (phase, self.sent.load(Ordering::Relaxed), self.total.load(Ordering::Relaxed))
+    }
+}
+
+struct HostKeyProbe(Arc<Mutex<Option<String>>>);
+
+impl client::Handler for HostKeyProbe {
+    type Error = russh::Error;
+
+    async fn check_server_key(
+        &mut self,
+        server_public_key: &PublicKeyOrCertificate,
+    ) -> std::result::Result<bool, Self::Error> {
+        *self.0.lock().unwrap() = server_public_key.public_key().to_openssh().ok();
+        Ok(false)
+    }
+}
+
+fn ipad_ssh_dir() -> Result<PathBuf> {
+    let home = PathBuf::from(std::env::var_os("HOME").context("HOME is not set")?);
+    Ok(home.join("Documents").join(".ssh"))
+}
+
+pub async fn probe_ssh_host(options: SshConnectionOptions) -> Result<SshHostIdentity> {
+    smol::unblock(move || {
+        let host = options.host.to_string();
+        let port = options.port.unwrap_or(22);
+        let captured = Arc::new(Mutex::new(None));
+        let runtime = tokio::runtime::Builder::new_current_thread().enable_all().build()?;
+        let config = Arc::new(client::Config::default());
+        let _ = runtime.block_on(async {
+            tokio::time::timeout(
+                Duration::from_secs(10),
+                client::connect(config, (host.as_str(), port), HostKeyProbe(captured.clone())),
+            ).await
+        });
+        let public_key = captured.lock().unwrap().clone()
+            .with_context(|| format!("Could not read SSH identity from {host}:{port}"))?;
+        let key = russh::keys::PublicKey::from_openssh(&public_key)?;
+        let fingerprint = key.fingerprint(HashAlg::Sha256).to_string();
+        let known = known_host_fingerprint(&ipad_ssh_dir()?.join("known_hosts"), &host, port).ok();
+        Ok(SshHostIdentity {
+            trusted: known.as_deref() == Some(fingerprint.as_str()),
+            changed: known.is_some() && known.as_deref() != Some(fingerprint.as_str()),
+            fingerprint,
+            public_key,
+        })
+    }).await
+}
+
+/// Trust only the exact identity the user reviewed. A later connection verifies it again.
+pub fn trust_ssh_host(options: &SshConnectionOptions, identity: &SshHostIdentity) -> Result<()> {
+    let dir = ipad_ssh_dir()?;
+    fs::create_dir_all(&dir)?;
+    fs::set_permissions(&dir, fs::Permissions::from_mode(0o700))?;
+    let host = options.host.to_string();
+    let port = options.port.unwrap_or(22);
+    let label = if port == 22 { host } else { format!("[{host}]:{port}") };
+    let key = russh::keys::PublicKey::from_openssh(&identity.public_key)?;
+    anyhow::ensure!(key.fingerprint(HashAlg::Sha256).to_string() == identity.fingerprint,
+        "SSH fingerprint changed during verification");
+    let path = dir.join("known_hosts");
+    let existing = fs::read_to_string(&path).unwrap_or_default();
+    let retained: Vec<_> = existing.lines().filter(|line| {
+        !line.split_whitespace().next().is_some_and(|names| {
+            names.split(',').any(|name| name.eq_ignore_ascii_case(&label))
+        })
+    }).collect();
+    let temporary = path.with_extension("tmp");
+    let mut file = OpenOptions::new().write(true).create_new(true).mode(0o600).open(&temporary)?;
+    for line in retained { writeln!(file, "{line}")?; }
+    writeln!(file, "{label} {}", identity.public_key)?;
+    file.sync_all()?;
+    fs::rename(temporary, path)?;
+    Ok(())
+}
+
+/// Return the public half of iZed's device key, generating the pair once if needed.
+pub fn ipad_public_key() -> Result<String> {
+    let dir = ipad_ssh_dir()?;
+    fs::create_dir_all(&dir)?;
+    fs::set_permissions(&dir, fs::Permissions::from_mode(0o700))?;
+    let path = dir.join("id_ed25519");
+    if !path.exists() {
+        let key = PrivateKey::random(&mut rand::rng(), Algorithm::Ed25519)?;
+        let mut file = OpenOptions::new().write(true).create_new(true).mode(0o600).open(&path)?;
+        key.write_openssh(&mut file, Default::default())?;
+    }
+    let key = russh::keys::load_secret_key(&path, None)?;
+    fs::set_permissions(path, fs::Permissions::from_mode(0o600))?;
+    Ok(key.public_key().to_openssh()?)
+}
+
+impl client::Handler for HostKeyVerifier {
+    type Error = russh::Error;
+
+    async fn check_server_key(
+        &mut self,
+        server_public_key: &PublicKeyOrCertificate,
+    ) -> std::result::Result<bool, Self::Error> {
+        let fingerprint = server_public_key
+            .public_key()
+            .fingerprint(HashAlg::Sha256)
+            .to_string();
+        Ok(fingerprint == self.expected_fingerprint)
+    }
+}
+
+pub struct IosSshRemoteConnection {
+    options: SshConnectionOptions,
+    runtime: Arc<tokio::runtime::Runtime>,
+    handle: Arc<client::Handle<HostKeyVerifier>>,
+    killed: Arc<AtomicBool>,
+}
+
+impl IosSshRemoteConnection {
+    pub async fn new(
+        options: SshConnectionOptions,
+        delegate: Arc<dyn RemoteClientDelegate>,
+        cx: &mut AsyncApp,
+    ) -> Result<Self> {
+        delegate.set_status(Some("Connecting over SSH"), cx);
+        let connect_options = options.clone();
+        let (runtime, handle) = smol::unblock(move || connect(&connect_options)).await?;
+        delegate.set_status(Some("SSH connected"), cx);
+        Ok(Self {
+            options,
+            runtime: Arc::new(runtime),
+            handle: Arc::new(handle),
+            killed: Arc::new(AtomicBool::new(false)),
+        })
+    }
+}
+
+fn connect(
+    options: &SshConnectionOptions,
+) -> Result<(tokio::runtime::Runtime, client::Handle<HostKeyVerifier>)> {
+    let ssh_dir = ipad_ssh_dir()?;
+    let host = options.host.to_string();
+    let port = options.port.unwrap_or(22);
+    let expected_fingerprint = known_host_fingerprint(&ssh_dir.join("known_hosts"), &host, port)?;
+    let key = russh::keys::load_secret_key(ssh_dir.join("id_ed25519"), None)
+        .context("load iZed SSH private key")?;
+    let username = options
+        .username
+        .clone()
+        .context("SSH username is missing")?;
+    let runtime = tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(2)
+        .enable_all()
+        .build()?;
+    let handle = runtime.block_on(async {
+        let config = Arc::new(client::Config {
+            inactivity_timeout: Some(Duration::from_secs(30)),
+            ..Default::default()
+        });
+        let mut handle = client::connect(
+            config,
+            (host.as_str(), port),
+            HostKeyVerifier {
+                expected_fingerprint,
+            },
+        )
+        .await
+        .with_context(|| format!("connect to {host}:{port}"))?;
+        let authenticated = handle
+            .authenticate_publickey(
+                username.clone(),
+                PrivateKeyWithHashAlg::new(Arc::new(key), None),
+            )
+            .await?
+            .success();
+        if !authenticated {
+            bail!("SSH key authentication failed for {username}@{host}");
+        }
+        anyhow::Ok(handle)
+    })?;
+    Ok((runtime, handle))
+}
+
+async fn run_ssh_command(options: SshConnectionOptions, command: String) -> Result<(u32, Vec<u8>)> {
+    smol::unblock(move || {
+        let (runtime, handle) = connect(&options)?;
+        runtime.block_on(async move {
+            let mut channel = handle.channel_open_session().await?;
+            channel.exec(true, command).await?;
+            let mut output = Vec::new();
+            let mut exit_status = None;
+            while let Some(message) = channel.wait().await {
+                match message {
+                    ChannelMsg::Data { data } => {
+                        anyhow::ensure!(output.len() + data.len() < 1024 * 1024, "Directory list is too large");
+                        output.extend_from_slice(data.as_ref());
+                    }
+                    ChannelMsg::ExitStatus { exit_status: code } => exit_status = Some(code),
+                    _ => {}
+                }
+            }
+            Ok((exit_status.context("SSH command ended without an exit status")?, output))
+        })
+    }).await
+}
+
+async fn upload_ssh_file(options: SshConnectionOptions, local_path: PathBuf, progress: Option<Arc<SshServerProgress>>) -> Result<()> {
+    smol::unblock(move || {
+        let mut file = File::open(&local_path)
+            .with_context(|| format!("open bundled server at {}", local_path.display()))?;
+        let (runtime, handle) = connect(&options)?;
+        runtime.block_on(async move {
+            let mut channel = handle.channel_open_session().await?;
+            channel.exec(true, "cat > \"$HOME/.zed_server/.ized-upload.gz\"").await?;
+            let mut buffer = [0u8; 64 * 1024];
+            let mut sent = 0u64;
+            loop {
+                let count = file.read(&mut buffer)?;
+                if count == 0 { break; }
+                channel.data_bytes(buffer[..count].to_vec()).await?;
+                sent += count as u64;
+                if let Some(progress) = &progress { progress.sent.store(sent, Ordering::Relaxed); }
+            }
+            channel.eof().await?;
+            let mut status = None;
+            let mut stderr = Vec::new();
+            while let Some(message) = channel.wait().await {
+                match message {
+                    ChannelMsg::ExitStatus { exit_status } => status = Some(exit_status),
+                    ChannelMsg::ExtendedData { data, .. } => stderr.extend_from_slice(data.as_ref()),
+                    _ => {}
+                }
+            }
+            anyhow::ensure!(status == Some(0), "Could not upload Zed server (SSH status {:?}): {}",
+                status, String::from_utf8_lossy(&stderr));
+            Ok(())
+        })
+    }).await
+}
+
+/// Install the matching server through the already trusted SSH connection.
+/// The remote Mac only needs SSH; it does not need the Zed desktop app.
+pub async fn ensure_ssh_server(options: SshConnectionOptions, archives_dir: PathBuf, progress: Option<Arc<SshServerProgress>>) -> Result<()> {
+    let (status, platform) = run_ssh_command(options.clone(), "uname -s; uname -m".into()).await?;
+    anyhow::ensure!(status == 0, "Could not identify the SSH machine (status {status})");
+    let platform = String::from_utf8(platform)?;
+    let mut lines = platform.lines();
+    let os = lines.next().unwrap_or_default().trim();
+    let arch = lines.next().unwrap_or_default().trim();
+    anyhow::ensure!(os == "Darwin", "Automatic Zed server setup currently supports macOS; this machine reports {os}");
+    let archive_name = match arch {
+        "arm64" => "macos-arm64.gz",
+        "x86_64" => "macos-x86_64.gz",
+        _ => bail!("Automatic Zed server setup does not support this Mac architecture: {arch}"),
+    };
+    let archive = archives_dir.join(archive_name);
+    let (digest, size) = smol::unblock({
+        let archive = archive.clone();
+        move || -> Result<(String, u64)> {
+            let mut file = File::open(&archive)
+                .with_context(|| format!("Zed server archive is missing from the app: {}", archive.display()))?;
+            let mut hasher = Sha256::new();
+            let mut size = 0;
+            let mut buffer = [0u8; 64 * 1024];
+            loop {
+                let count = file.read(&mut buffer)?;
+                if count == 0 { break; }
+                hasher.update(&buffer[..count]);
+                size += count as u64;
+            }
+            anyhow::ensure!(size > 0, "Zed server archive is empty");
+            Ok((format!("{:x}", hasher.finalize()), size))
+        }
+    }).await?;
+    let marker = "$HOME/.zed_server/.ized-server-sha256";
+    let binary = "$HOME/.zed_server/zed-remote-server-dev-build";
+    let check = format!("if [ -x \"{binary}\" ] && [ -f \"{marker}\" ]; then cat \"{marker}\"; fi");
+    let (status, installed_digest) = run_ssh_command(options.clone(), check).await?;
+    anyhow::ensure!(status == 0, "Could not check installed Zed server (status {status})");
+    if String::from_utf8_lossy(&installed_digest).trim() == digest {
+        if let Some(progress) = &progress { progress.phase.store(3, Ordering::Relaxed); }
+        return Ok(());
+    }
+
+    let (status, _) = run_ssh_command(options.clone(), "mkdir -p \"$HOME/.zed_server\"".into()).await?;
+    anyhow::ensure!(status == 0, "Could not create Zed server directory (status {status})");
+    log::info!("Uploading {} byte Zed server for macOS {arch}", size);
+    if let Some(progress) = &progress {
+        progress.total.store(size, Ordering::Relaxed);
+        progress.phase.store(1, Ordering::Relaxed);
+    }
+    upload_ssh_file(options.clone(), archive, progress.clone()).await?;
+    if let Some(progress) = &progress { progress.phase.store(2, Ordering::Relaxed); }
+    let install = format!(
+        "set -e; printf '%s  %s\\n' '{digest}' \"$HOME/.zed_server/.ized-upload.gz\" | shasum -a 256 -c -; \
+         gzip -dc \"$HOME/.zed_server/.ized-upload.gz\" > \"$HOME/.zed_server/zed-remote-server-dev-build.new\"; \
+         chmod 755 \"$HOME/.zed_server/zed-remote-server-dev-build.new\"; \
+         mv \"$HOME/.zed_server/zed-remote-server-dev-build.new\" \"{binary}\"; \
+         printf '%s\\n' '{digest}' > \"{marker}\"; rm \"$HOME/.zed_server/.ized-upload.gz\""
+    );
+    let (status, _) = run_ssh_command(options, install).await?;
+    anyhow::ensure!(status == 0, "Could not verify and install the Zed server (SSH status {status})");
+    if let Some(progress) = &progress { progress.phase.store(3, Ordering::Relaxed); }
+    Ok(())
+}
+
+fn quoted_directory(path: &str) -> Result<String> {
+    anyhow::ensure!(path.starts_with('/') && !path.contains('\0'), "Enter an absolute remote folder path");
+    Ok(format!("'{}'", path.replace('\'', "'\\''")))
+}
+
+/// Verify the selected path before changing workspaces. Keep path failures
+/// separate from transport and remote-server failures.
+pub async fn check_ssh_directory(options: SshConnectionOptions, path: String) -> Result<()> {
+    let quoted = quoted_directory(&path)?;
+    let command = format!(
+        "dir={quoted}; if [ ! -e \"$dir\" ]; then exit 2; elif [ ! -d \"$dir\" ]; then exit 3; elif [ ! -r \"$dir\" ] || [ ! -x \"$dir\" ]; then exit 4; fi; exit 0"
+    );
+    let (status, _) = run_ssh_command(options, command).await?;
+    match status {
+        0 => Ok(()),
+        2 => bail!("Remote folder was not found or is not accessible: {path}"),
+        3 => bail!("Remote path is not a folder: {path}"),
+        4 => bail!("Remote folder is not accessible: {path}"),
+        _ => bail!("Could not check remote folder {path} (SSH exit status {status})"),
+    }
+}
+
+/// Resolve `~/` using the authenticated SSH user's actual home directory.
+pub async fn ssh_home_directory(options: SshConnectionOptions) -> Result<String> {
+    let (status, output) = run_ssh_command(options, "printf '%s' \"$HOME\"".into()).await?;
+    anyhow::ensure!(status == 0, "Could not find the Machine home folder (SSH status {status})");
+    let home = String::from_utf8(output)?;
+    let home = home.trim_end_matches('/');
+    anyhow::ensure!(home.starts_with('/'), "Machine returned an invalid home folder");
+    Ok(home.to_owned())
+}
+
+/// List immediate child directories over the same authenticated SSH transport
+/// used by the iPad remote workspace. Paths are NUL separated to preserve
+/// spaces and other shell-sensitive characters in directory names.
+pub async fn list_ssh_directories(options: SshConnectionOptions, path: String) -> Result<Vec<String>> {
+    let quoted = quoted_directory(&path)?;
+    let command = format!(
+        "dir={quoted}; if [ ! -e \"$dir\" ]; then exit 2; elif [ ! -d \"$dir\" ]; then exit 3; elif [ ! -r \"$dir\" ] || [ ! -x \"$dir\" ]; then exit 4; fi; find \"$dir\" -mindepth 1 -maxdepth 1 -type d -print0"
+    );
+    let (status, output) = run_ssh_command(options, command).await?;
+    if status == 2 { bail!("Remote folder was not found or is not accessible: {path}") }
+    if status == 3 { bail!("Remote path is not a folder: {path}") }
+    if status == 4 { bail!("Remote folder is not accessible: {path}") }
+    anyhow::ensure!(status == 0, "Could not list remote folder {path} (SSH exit status {status})");
+    let mut directories = output
+        .split(|byte| *byte == 0)
+        .filter(|entry| !entry.is_empty())
+        .map(|entry| String::from_utf8(entry.to_vec()))
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    directories.sort_by_key(|entry| entry.to_lowercase());
+    Ok(directories)
+}
+
+fn known_host_fingerprint(path: &PathBuf, host: &str, port: u16) -> Result<String> {
+    let content = std::fs::read_to_string(path)
+        .with_context(|| format!("read SSH known hosts at {}", path.display()))?;
+    let host_label = if port == 22 {
+        host.to_owned()
+    } else {
+        format!("[{host}]:{port}")
+    };
+    for line in content.lines() {
+        let mut fields = line.split_whitespace();
+        let Some(names) = fields.next() else { continue };
+        if !names
+            .split(',')
+            .any(|name| name.eq_ignore_ascii_case(&host_label))
+        {
+            continue;
+        }
+        let (Some(algorithm), Some(encoded_key)) = (fields.next(), fields.next()) else {
+            continue;
+        };
+        let key = russh::keys::PublicKey::from_openssh(&format!("{algorithm} {encoded_key}"))?;
+        return Ok(key.fingerprint(HashAlg::Sha256).to_string());
+    }
+    bail!("SSH host {host_label} is missing from known_hosts")
+}
+
+async fn run_proxy(
+    handle: Arc<client::Handle<HostKeyVerifier>>,
+    identifier: String,
+    reconnect: bool,
+    incoming_tx: UnboundedSender<Envelope>,
+    mut outgoing_rx: UnboundedReceiver<Envelope>,
+    mut connection_activity_tx: Sender<()>,
+    killed: Arc<AtomicBool>,
+) -> Result<i32> {
+    if !identifier
+        .chars()
+        .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')
+    {
+        bail!("invalid remote proxy identifier");
+    }
+    let command = format!(
+        "~/.zed_server/zed-remote-server-dev-build proxy --identifier {identifier}{}",
+        if reconnect { " --reconnect" } else { "" }
+    );
+    let mut channel = handle.channel_open_session().await?;
+    channel.exec(true, command).await?;
+
+    let mut incoming = Vec::new();
+    let mut outgoing_open = true;
+    let mut exit_status = 0;
+    loop {
+        tokio::select! {
+            message = channel.wait() => match message {
+                Some(ChannelMsg::Data { data }) => {
+                    incoming.extend_from_slice(data.as_ref());
+                    while incoming.len() >= 4 {
+                        let length = u32::from_le_bytes(incoming[..4].try_into().unwrap()) as usize;
+                        if length > 64 * 1024 * 1024 { bail!("remote message is too large") }
+                        if incoming.len() < 4 + length { break }
+                        let envelope = Envelope::decode(&incoming[4..4 + length])?;
+                        incoming.drain(..4 + length);
+                        connection_activity_tx.try_send(()).ok();
+                        incoming_tx.unbounded_send(envelope).ok();
+                    }
+                }
+                Some(ChannelMsg::ExtendedData { data, .. }) => {
+                    log::info!("remote server: {}", String::from_utf8_lossy(data.as_ref()));
+                }
+                Some(ChannelMsg::ExitStatus { exit_status: code }) => exit_status = code as i32,
+                Some(_) => {}
+                None => break,
+            },
+            outbound = outgoing_rx.next(), if outgoing_open => match outbound {
+                Some(envelope) => {
+                    let length = envelope.encoded_len();
+                    if length > 64 * 1024 * 1024 { bail!("remote message is too large") }
+                    let mut data = Vec::with_capacity(4 + length);
+                    data.extend_from_slice(&(length as u32).to_le_bytes());
+                    envelope.encode(&mut data)?;
+                    channel.data_bytes(data).await?;
+                }
+                None => outgoing_open = false,
+            },
+            _ = tokio::time::sleep(Duration::from_millis(100)) => {
+                if killed.load(Ordering::Relaxed) { break }
+            },
+        }
+    }
+    Ok(exit_status)
+}
+
+#[async_trait(?Send)]
+impl RemoteConnection for IosSshRemoteConnection {
+    fn start_proxy(
+        &self,
+        unique_identifier: String,
+        reconnect: bool,
+        incoming_tx: UnboundedSender<Envelope>,
+        outgoing_rx: UnboundedReceiver<Envelope>,
+        connection_activity_tx: Sender<()>,
+        delegate: Arc<dyn RemoteClientDelegate>,
+        cx: &mut AsyncApp,
+    ) -> Task<Result<i32>> {
+        delegate.set_status(Some("Starting Zed remote server"), cx);
+        let runtime = self.runtime.clone();
+        let handle = self.handle.clone();
+        let killed = self.killed.clone();
+        cx.background_spawn(async move {
+            smol::unblock(move || {
+                runtime.block_on(run_proxy(
+                    handle,
+                    unique_identifier,
+                    reconnect,
+                    incoming_tx,
+                    outgoing_rx,
+                    connection_activity_tx,
+                    killed,
+                ))
+            })
+            .await
+        })
+    }
+
+    fn upload_directory(&self, _: PathBuf, _: RemotePathBuf, _: &App) -> Task<Result<()>> {
+        Task::ready(Err(anyhow!(
+            "uploading files over iPad SSH is not available"
+        )))
+    }
+
+    async fn kill(&self) -> Result<()> {
+        self.killed.store(true, Ordering::Relaxed);
+        Ok(())
+    }
+
+    fn has_been_killed(&self) -> bool {
+        self.killed.load(Ordering::Relaxed)
+    }
+
+    fn build_command(
+        &self,
+        _: Option<String>,
+        _: &[String],
+        _: &HashMap<String, String>,
+        _: Option<String>,
+        _: Option<(u16, String, u16)>,
+        _: Interactive,
+    ) -> Result<CommandTemplate> {
+        Err(anyhow!("remote commands are not available on iPad yet"))
+    }
+
+    fn build_forward_ports_command(&self, _: Vec<(u16, String, u16)>) -> Result<CommandTemplate> {
+        Err(anyhow!("port forwarding is not available on iPad yet"))
+    }
+
+    fn connection_options(&self) -> RemoteConnectionOptions {
+        RemoteConnectionOptions::Ssh(self.options.clone())
+    }
+
+    fn path_style(&self) -> PathStyle {
+        PathStyle::Posix
+    }
+    fn shell(&self) -> String {
+        "/bin/sh".into()
+    }
+    fn default_system_shell(&self) -> String {
+        "/bin/sh".into()
+    }
+    fn has_wsl_interop(&self) -> bool {
+        false
+    }
+}
