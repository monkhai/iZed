+fn bundled_archive_digest(archive: &Path) -> Result<(String, u64)> {
+    // The app bundle cannot change while this process is running. Hash each
+    // bundled archive once instead of reading it again for every project open.
+    static DIGESTS: OnceLock<Mutex<HashMap<PathBuf, (String, u64)>>> = OnceLock::new();
+    let digests = DIGESTS.get_or_init(|| Mutex::new(HashMap::default()));
+    if let Some(digest) = digests
+        .lock()
+        .unwrap_or_else(|poison| poison.into_inner())
+        .get(archive)
+        .cloned()
+    {
+        return Ok(digest);
+    }
+
+    let mut file = File::open(archive)
+        .with_context(|| format!("Zed server archive is missing from the app: {}", archive.display()))?;
+    let mut hasher = Sha256::new();
+    let mut size = 0;
+    let mut buffer = [0u8; 64 * 1024];
+    loop {
+        let count = file.read(&mut buffer)?;
+        if count == 0 { break; }
+        hasher.update(&buffer[..count]);
+        size += count as u64;
+    }
+    anyhow::ensure!(size > 0, "Zed server archive is empty");
+    let digest = (format!("{:x}", hasher.finalize()), size);
+    digests
+        .lock()
+        .unwrap_or_else(|poison| poison.into_inner())
+        .insert(archive.to_path_buf(), digest.clone());
+    Ok(digest)
+}
