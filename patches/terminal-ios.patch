+/// A PTY on the selected Machine, carried over its own authenticated SSH session.
+pub struct SshTerminalSession {
+    pub input_tx: SmolSender<Vec<u8>>,
+    pub resize_tx: SmolSender<(u32, u32)>,
+    pub output_rx: SmolReceiver<Vec<u8>>,
+}
+
+pub async fn open_ssh_terminal(
+    options: SshConnectionOptions,
+    working_directory: Option<PathBuf>,
+) -> Result<SshTerminalSession> {
+    let (input_tx, input_rx) = smol::channel::unbounded();
+    let (resize_tx, resize_rx) = smol::channel::unbounded();
+    let (output_tx, output_rx) = smol::channel::unbounded();
+    let (ready_tx, ready_rx) = smol::channel::bounded::<std::result::Result<(), String>>(1);
+
+    std::thread::Builder::new()
+        .name("ized-ssh-terminal".into())
+        .spawn(move || {
+            let result = run_ssh_terminal(
+                options,
+                working_directory,
+                input_rx,
+                resize_rx,
+                output_tx.clone(),
+                ready_tx.clone(),
+            );
+            if let Err(error) = result {
+                let message = format!("{error:#}");
+                if ready_tx.try_send(Err(message.clone())).is_err() {
+                    output_tx
+                        .send_blocking(format!("\r\n[SSH terminal: {message}]\r\n").into_bytes())
+                        .ok();
+                }
+            }
+        })?;
+
+    ready_rx
+        .recv()
+        .await
+        .context("SSH terminal stopped before opening")?
+        .map_err(anyhow::Error::msg)?;
+    Ok(SshTerminalSession {
+        input_tx,
+        resize_tx,
+        output_rx,
+    })
+}
+
+fn run_ssh_terminal(
+    options: SshConnectionOptions,
+    working_directory: Option<PathBuf>,
+    input_rx: SmolReceiver<Vec<u8>>,
+    resize_rx: SmolReceiver<(u32, u32)>,
+    output_tx: SmolSender<Vec<u8>>,
+    ready_tx: SmolSender<std::result::Result<(), String>>,
+) -> Result<()> {
+    let (runtime, handle) = connect_with_inactivity_timeout(&options, None)?;
+    runtime.block_on(async move {
+        let mut channel = handle.channel_open_session().await?;
+        channel
+            .request_pty(true, "xterm-256color", 80, 24, 0, 0, &[])
+            .await?;
+        let command = if let Some(path) = working_directory {
+            let path = path.to_string_lossy().replace('\'', "'\\''");
+            format!("cd '{path}' && exec \"${{SHELL:-/bin/sh}}\" -l")
+        } else {
+            "exec \"${SHELL:-/bin/sh}\" -l".to_string()
+        };
+        channel.exec(true, command).await?;
+        ready_tx.send(Ok(())).await.ok();
+
+        let mut input_open = true;
+        let mut resize_open = true;
+        let mut exit_status = None;
+        loop {
+            tokio::select! {
+                message = channel.wait() => match message {
+                    Some(ChannelMsg::Data { data }) | Some(ChannelMsg::ExtendedData { data, .. }) => {
+                        if output_tx.send(data.as_ref().to_vec()).await.is_err() {
+                            log::info!("iPad SSH terminal output receiver closed");
+                            break;
+                        }
+                    }
+                    Some(ChannelMsg::ExitStatus { exit_status: code }) => exit_status = Some(code),
+                    Some(_) => {}
+                    None => {
+                        log::info!("iPad SSH terminal channel closed with status {exit_status:?}");
+                        break;
+                    }
+                },
+                input = input_rx.recv(), if input_open => match input {
+                    Ok(input) => channel.data_bytes(input).await?,
+                    Err(_) => {
+                        log::info!("iPad SSH terminal input sender closed");
+                        input_open = false;
+                        break;
+                    }
+                },
+                resize = resize_rx.recv(), if resize_open => match resize {
+                    Ok((columns, rows)) => channel.window_change(columns, rows, 0, 0).await?,
+                    Err(_) => {
+                        log::info!("iPad SSH terminal resize sender closed");
+                        resize_open = false;
+                    },
+                },
+            }
+        }
+        output_tx.send(b"\r\n[Terminal session ended]\r\n".to_vec()).await.ok();
+        anyhow::Ok(())
+    })
+}
