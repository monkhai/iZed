+#[cfg(target_os = "ios")]
+struct IosSshTransport {
+    input: Option<async_pipe::PipeWriter>,
+    output: Option<async_pipe::PipeReader>,
+    tasks: Vec<Task<()>>,
+}
+
+#[cfg(target_os = "ios")]
+impl IosSshTransport {
+    async fn start(binary: &DebugAdapterBinary, cx: &mut AsyncApp) -> Result<Self> {
+        let options = serde_json::from_str(
+            binary.arguments.first().context("Missing SSH Machine for debug adapter")?,
+        )?;
+        let program = binary.arguments.get(1).context("Missing remote debug adapter command")?;
+        let session = remote::open_ssh_process(
+            options,
+            program.clone(),
+            binary.arguments[2..].to_vec(),
+            binary.envs.clone(),
+            binary.cwd.clone(),
+        )
+        .await?;
+
+        let (input, mut input_reader) = async_pipe::pipe();
+        let (mut output_writer, output) = async_pipe::pipe();
+        let input_tx = session.input_tx;
+        let output_rx = session.output_rx;
+        let error_rx = session.error_rx;
+        let input_task = cx.background_spawn(async move {
+            let mut buffer = [0u8; 8192];
+            loop {
+                match input_reader.read(&mut buffer).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(length) => {
+                        if input_tx.send(buffer[..length].to_vec()).await.is_err() { break; }
+                    }
+                }
+            }
+        });
+        let output_task = cx.background_spawn(async move {
+            while let Ok(bytes) = output_rx.recv().await {
+                if output_writer.write_all(&bytes).await.is_err() { break; }
+            }
+        });
+        let error_task = cx.background_spawn(async move {
+            while let Ok(bytes) = error_rx.recv().await {
+                log::warn!("SSH debug adapter: {}", String::from_utf8_lossy(&bytes));
+            }
+        });
+        Ok(Self {
+            input: Some(input),
+            output: Some(output),
+            tasks: vec![input_task, output_task, error_task],
+        })
+    }
+}
+
+#[cfg(target_os = "ios")]
+impl Transport for IosSshTransport {
+    fn has_adapter_logs(&self) -> bool { true }
+    fn tcp_arguments(&self) -> Option<TcpArguments> { None }
+    fn kill(&mut self) {
+        self.input.take();
+        self.output.take();
+        self.tasks.clear();
+    }
+    fn connect(
+        &mut self,
+    ) -> Task<Result<(
+        Box<dyn AsyncWrite + Unpin + Send + 'static>,
+        Box<dyn AsyncRead + Unpin + Send + 'static>,
+    )>> {
+        let result = match (self.input.take(), self.output.take()) {
+            (Some(input), Some(output)) => Ok((Box::new(input) as _, Box::new(output) as _)),
+            _ => Err(anyhow!("Cannot reconnect to an SSH debug adapter")),
+        };
+        Task::ready(result)
+    }
+}
+
+#[cfg(target_os = "ios")]
+impl Drop for IosSshTransport {
+    fn drop(&mut self) { self.kill(); }
+}
