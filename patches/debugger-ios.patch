+/// A non-PTY process on the Machine, for protocols such as DAP that use stdio.
+pub struct SshProcessSession {
+    pub input_tx: SmolSender<Vec<u8>>,
+    pub output_rx: SmolReceiver<Vec<u8>>,
+    pub error_rx: SmolReceiver<Vec<u8>>,
+}
+
+pub async fn open_ssh_process(
+    options: SshConnectionOptions,
+    program: String,
+    arguments: Vec<String>,
+    environment: HashMap<String, String>,
+    working_directory: Option<PathBuf>,
+) -> Result<SshProcessSession> {
+    let (input_tx, input_rx) = smol::channel::unbounded();
+    let (output_tx, output_rx) = smol::channel::unbounded();
+    let (error_tx, error_rx) = smol::channel::unbounded();
+    let (ready_tx, ready_rx) = smol::channel::bounded::<std::result::Result<(), String>>(1);
+
+    std::thread::Builder::new()
+        .name("ized-ssh-debug-adapter".into())
+        .spawn(move || {
+            let result = run_ssh_process(
+                options,
+                program,
+                arguments,
+                environment,
+                working_directory,
+                input_rx,
+                output_tx,
+                error_tx.clone(),
+                ready_tx.clone(),
+            );
+            if let Err(error) = result {
+                let message = format!("{error:#}");
+                if ready_tx.try_send(Err(message.clone())).is_err() {
+                    error_tx.send_blocking(message.into_bytes()).ok();
+                }
+            }
+        })?;
+
+    ready_rx
+        .recv()
+        .await
+        .context("SSH debug adapter stopped before opening")?
+        .map_err(anyhow::Error::msg)?;
+    Ok(SshProcessSession { input_tx, output_rx, error_rx })
+}
+
+/// Run a finite task on a Machine, returning its exit status and combined output.
+/// Debugger build tasks use this instead of spawning the desktop SSH executable.
+pub async fn run_ssh_task(
+    options: SshConnectionOptions,
+    program: String,
+    arguments: Vec<String>,
+    environment: HashMap<String, String>,
+    working_directory: Option<PathBuf>,
+) -> Result<(u32, Vec<u8>)> {
+    smol::unblock(move || {
+        let mut command = String::new();
+        if let Some(path) = working_directory {
+            command.push_str("cd ");
+            command.push_str(&ssh_quote(&path.to_string_lossy()));
+            command.push_str(" && ");
+        }
+        command.push_str("env");
+        for (name, value) in environment {
+            command.push(' ');
+            command.push_str(&ssh_quote(&format!("{name}={value}")));
+        }
+        command.push(' ');
+        command.push_str(&ssh_quote(&program));
+        for argument in arguments {
+            command.push(' ');
+            command.push_str(&ssh_quote(&argument));
+        }
+
+        let (runtime, handle) = connect_with_inactivity_timeout(&options, None)?;
+        runtime.block_on(async move {
+            let mut channel = handle.channel_open_session().await?;
+            channel.exec(true, command).await?;
+            let mut output = Vec::new();
+            let mut status = None;
+            while let Some(message) = channel.wait().await {
+                match message {
+                    ChannelMsg::Data { data } | ChannelMsg::ExtendedData { data, .. } => {
+                        anyhow::ensure!(output.len() + data.len() <= 16 * 1024 * 1024, "Remote build output exceeded 16 MB");
+                        output.extend_from_slice(data.as_ref());
+                    }
+                    ChannelMsg::ExitStatus { exit_status } => status = Some(exit_status),
+                    _ => {}
+                }
+            }
+            Ok((status.context("Remote build ended without an exit status")?, output))
+        })
+    }).await
+}
+
+fn ssh_quote(value: &str) -> String {
+    format!("'{}'", value.replace('\'', "'\\''"))
+}
+
+fn run_ssh_process(
+    options: SshConnectionOptions,
+    program: String,
+    arguments: Vec<String>,
+    environment: HashMap<String, String>,
+    working_directory: Option<PathBuf>,
+    input_rx: SmolReceiver<Vec<u8>>,
+    output_tx: SmolSender<Vec<u8>>,
+    error_tx: SmolSender<Vec<u8>>,
+    ready_tx: SmolSender<std::result::Result<(), String>>,
+) -> Result<()> {
+    let mut command = String::new();
+    if let Some(path) = working_directory {
+        command.push_str("cd ");
+        command.push_str(&ssh_quote(&path.to_string_lossy()));
+        command.push_str(" && ");
+    }
+    command.push_str("exec env");
+    for (name, value) in environment {
+        command.push(' ');
+        command.push_str(&ssh_quote(&format!("{name}={value}")));
+    }
+    command.push(' ');
+    command.push_str(&ssh_quote(&program));
+    for argument in arguments {
+        command.push(' ');
+        command.push_str(&ssh_quote(&argument));
+    }
+
+    let (runtime, handle) = connect_with_inactivity_timeout(&options, None)?;
+    runtime.block_on(async move {
+        let mut channel = handle.channel_open_session().await?;
+        channel.exec(true, command).await?;
+        ready_tx.send(Ok(())).await.ok();
+
+        loop {
+            tokio::select! {
+                message = channel.wait() => match message {
+                    Some(ChannelMsg::Data { data }) => {
+                        if output_tx.send(data.as_ref().to_vec()).await.is_err() { break; }
+                    }
+                    Some(ChannelMsg::ExtendedData { data, .. }) => {
+                        error_tx.send(data.as_ref().to_vec()).await.ok();
+                    }
+                    Some(ChannelMsg::ExitStatus { exit_status }) => {
+                        log::info!("iPad SSH debug adapter exited with status {exit_status}");
+                    }
+                    Some(_) => {}
+                    None => break,
+                },
+                input = input_rx.recv() => match input {
+                    Ok(input) => channel.data_bytes(input).await?,
+                    Err(_) => {
+                        channel.eof().await.ok();
+                        break;
+                    }
+                }
+            }
+        }
+        anyhow::Ok(())
+    })
+}
+
 pub async fn open_ssh_terminal(
     options: SshConnectionOptions,
     working_directory: Option<PathBuf>,
