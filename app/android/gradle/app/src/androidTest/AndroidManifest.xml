<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service android:name="com.monkhai.ized.platform.QuietImeService"
            android:label="iZed composition probe (emulator only)"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/quiet_ime" />
        </service>
    </application>
</manifest>
